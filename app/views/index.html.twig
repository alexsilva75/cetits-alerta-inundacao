    <script>
        const map = L.map('map');

        const ufMapping = {
            'BR-BA': 'BA',
            'BR-SP': 'SP',  
            'BR-RJ': 'RJ',
            'BR-PE': 'PE',
            'BR-CE': 'CE',
            'BR-AL': 'AL',
            'BR-SE': 'SE',
            'BR-PB': 'PB',
            'BR-RN': 'RN',
            'BR-PI': 'PI',
            'BR-MA': 'MA',
            'BR-ES': 'ES',
            'BR-MS': 'MS',
            'BR-MT': 'MT',
            'BR-GO': 'GO',
            'BR-DF': 'DF',
            'BR-PR': 'PR',
            'BR-SC': 'SC',
            'BR-RS': 'RS',
            'BR-AP': 'AP',
            'BR-AC': 'AC',
            'BR-AM': 'AM',
            'BR-RO': 'RO',
            'BR-RR': 'RR',
            'BR-PA': 'PA',
            'BR-TO': 'TO',
            'BR-AP': 'AP'         
             

        }

        function reverseGeocoding(userLat, userLng){
            fetch(`https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=${userLat}&longitude=${userLng}&localityLanguage=pt`)
            .then(response => response.json()).then(data => {
                console.log("Localização do usuário:", data.city, data.principalSubdivision, data.principalSubdivisionCode);
                document.querySelector('#city').innerHTML = data.city;
                buildMap(userLat, userLng);
                loadIncidents(data.city, ufMapping[data.principalSubdivisionCode]);
            
            }).catch(error => {
                console.error("Erro ao obter localização do usuário:", error);
            });
        }

        function buildMap(userLat, userLng){            

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
            }).addTo(map);

            map.setView([userLat, userLng], 13);
        }

        function loadIncidents(city, uf){
            fetch(`/api/incidentes/last-in-location?city=${city}&uf=${uf}`)
            .then(response => response.json())
            .then(data => {
                if(data.length != 0){
                    console.log('Iterando sobre incidentes')
                    data.forEach(incidente => {
                        L.marker([incidente.latitude, incidente.longitude])
                            .addTo(map)
                            .bindPopup(`<b>Descrição:</b> ${incidente.descricao}<br><b>Data/Hora:</b> ${incidente.data_hora}`);
                    });
                }
            })
            .catch(error => console.error('Erro ao carregar incidentes:', error));


            const container = document.getElementById('incidentes');

            fetch(`/incidentes/last-in-location?city=${city}&uf=${uf}`)
            .then(response => {
                if(!reponse.ok){
                    throw new Error(`HTTP error! Status: ${response.status}`);
                }
                return response.text();
                
            }).then(response => {
                container.innerHTML = response.text();
            })
            .catch(error => console.error('Erro ao carregar incidentes:', error));
        }
        //.setView([-12.5797, -38.4037], 13); // Salvador
        //map.setView([-12.5797, -38.4037], 13);

        let userLat;
        let userLng;
        if("geolocation" in navigator) {
            console.log("Obtendo localização");
            navigator.geolocation.getCurrentPosition(function(position) {
                console.log("Obtendo latitude.");
                userLat = position.coords.latitude;
                userLng = position.coords.longitude;
                //console.log("User coordinations: ${userLat}, ${userLng}");
                
                reverseGeocoding(userLat, userLng);
            },function(err){
                console.log(err)
                if(err.code == 2){
                    userLat = -12.5571238//-12.9711;
                    userLng = -38.7343115//-38.5108;
                    console.log(`User coordinations: ${userLat}, ${userLng}`);
                    reverseGeocoding(userLat, userLng);
                }
            }, {});

            
        }else {
            // Se geolocalização não for suportada, centraliza em Salvador
            console.log("Exibindo mapa com posição default");
            reverseGeocoding(-12.5797, -38.4037);
        }

        

        
