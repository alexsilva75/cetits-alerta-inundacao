<!DOCTYPE html>
<html lang="pt-br">
<head>
    <title>Alerta de Inundação</title>
    {{ include('layouts/partials/_head_content.html.twig') }}
</head>

<body>

    <div class="container-fluid ">
        <div class="row">
            <div class="col-8 map-container">
                <h1>Alerta de Inundação</h1>
                <h2>Sistema para registro de pontos de risco de alagamento</h2>

                <p>Pontos de alagamento registrados na última semana.</p>

                <div id="map"></div>

                

                {% if incidentes is empty %}
                    <p>Nenhum incidente registrado na última semana.</p>
                {% else %}
                    <div class="alert alert-info" role="alert">
                    
                    {% for incidente in incidentes %}
                        <p>{{ incidente.descricao }} - {{ incidente.latitude }}, {{ incidente.longitude }} - {{ incidente.data_hora }}</p>
                    {% endfor %}
                </div>

                {% endif %}
                

            </div>
            <!--login-->
            {% include 'layouts/partials/_login_form.html.twig' %}
        </div>

    </div>

    <!-- footer -->
    {% include 'layouts/partials/_footer.html.twig' %}

    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <script>

        const map = L.map('map');//.setView([-12.5797, -38.4037], 13); // Salvador

        if("geolocation" in navigator) {
            navigator.geolocation.getCurrentPosition(function(position) {
                const userLat = position.coords.latitude;
                const userLng = position.coords.longitude;
                map.setView([userLat, userLng], 13);
            });
        }else {
            // Se geolocalização não for suportada, centraliza em Salvador
            map.setView([-12.5797, -38.4037], 13);
        }

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '&copy; OpenStreetMap'
        }).addTo(map);

        fetch('/api/incidentes/last-week')
            .then(response => response.json())
            .then(data => {
                data.forEach(incidente => {
                    L.marker([incidente.latitude, incidente.longitude])
                        .addTo(map)
                        .bindPopup(`<b>Descrição:</b> ${incidente.descricao}<br><b>Data/Hora:</b> ${incidente.data_hora}`);
                });
            })
            .catch(error => console.error('Erro ao carregar incidentes:', error));
        //let marker;

        // Evento de clique no mapa
        /*map.on('click', function (e) {

            const lat = e.latlng.lat;
            const lng = e.latlng.lng;

            // Atualiza formulário
            document.getElementById("latitude").value = lat;
            document.getElementById("longitude").value = lng;

            // Remove marcador anterior
            if (marker) {
                map.removeLayer(marker);
            }

            // Adiciona novo marcador
            marker = L.marker([lat, lng]).addTo(map);

        });*/

    </script>

    <script src="./js/bootstrap/js/bootstrap.min.js"></script>
</body>

</html>